# ===== Solo para correr la API en su PC. En Azure estos valores se definen en la Container App. =====

# --- Azure SQL (misma base de SIGELAB) ---
DB_HOST=sigelabumg.database.windows.net
DB_PORT=1433
DB_NAME=sigelabadministrador
DB_USER=CAMBIAR
DB_PASSWORD=CAMBIAR
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no

# --- Tabla de usuarios de SIGELAB (ajuste a su esquema) ---
USERS_TABLE=Usuario
USER_ID_COLUMN=IdUsuario
USER_NAME_COLUMN=NombreUsuario
# Deje vacías las dos siguientes si su tabla no tiene esas columnas.
USER_ROLE_COLUMN=IdRol
USER_ACTIVE_COLUMN=Estado
# IdRol de los administradores (Estado debe ser ACTIVO)
ADMIN_ROLES=1

# --- Seguridad (genere con: python -m scripts.generate_key) ---
# Varias claves separadas por coma (ej. una para escritorio y otra para el celular).
API_KEYS=CAMBIAR
# NO cambiar después de registrar rostros.
FACIAL_ENCRYPTION_KEY=CAMBIAR

# --- Modelo y calibración ---
FACE_MODEL=buffalo_l
FACE_MATCH_THRESHOLD=0.55
REQUIRE_LIVENESS=true
FRONT_MAX_YAW=10
TURN_MIN_YAW=15
MAX_YAW=40
MAX_PITCH=25
FACE_MIN_SIZE=90
BLUR_THRESHOLD=60
ENROLL_MIN_IMAGES=5
ENROLL_MIN_FRONT=2
MAX_IMAGES=12
