<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SIGELAB.view.FrmLaboratorios">
  <grid id="c0000" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="1100" height="820"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="scroll" binding="scrollContenido">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="contenido" layout-manager="GridLayoutManager" row-count="6" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="14">
            <margin top="24" left="28" bottom="24" right="28"/>
            <constraints/>
            <properties>
              <background color="-3289651"/>
            </properties>
            <border type="none"/>
            <children>
              <!-- 1. ENCABEZADO DEL MÓDULO -->
              <grid id="cabecera" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="4">
                <margin top="0" left="0" bottom="4" right="0"/>
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="c0001" class="javax.swing.JLabel" binding="lblTitulo">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Gestión de Laboratorios"/>
                    </properties>
                  </component>
                  <component id="btnSol" class="javax.swing.JButton" binding="btnModoClaro">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="43" height="35"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="☀"/>
                      <toolTipText value="Modo claro"/>
                    </properties>
                  </component>
                  <component id="btnLuna" class="javax.swing.JButton" binding="btnModoOscuro">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="43" height="35"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="☾"/>
                      <toolTipText value="Modo oscuro"/>
                    </properties>
                  </component>
                  <component id="subtitulo" class="javax.swing.JLabel" binding="lblSubtitulo">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="CATÁLOGOS  |  Laboratorios de la universidad, ubicación, capacidad y estado"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 2. TARJETA: BÚSQUEDA -->
              <grid id="c0020" binding="cardBusqueda" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
                <margin top="16" left="20" bottom="16" right="20"/>
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secBus" class="javax.swing.JLabel" binding="lblSeccionBusqueda">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="BÚSQUEDA"/>
                    </properties>
                  </component>
                  <component id="c0021" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Buscar:"/>
                    </properties>
                  </component>
                  <component id="c0022" class="javax.swing.JTextField" binding="txtBuscar">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="260" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <toolTipText value="Código o nombre del laboratorio"/>
                    </properties>
                  </component>
                  <component id="c0023" class="javax.swing.JButton" binding="btnBuscar">
                    <constraints>
                      <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="110" height="36"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Buscar"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 3. TARJETA: DATOS DEL LABORATORIO -->
              <grid id="c0002" binding="cardDatos" layout-manager="GridLayoutManager" row-count="4" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="14" vgap="10">
                <margin top="18" left="20" bottom="18" right="20"/>
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secDat" class="javax.swing.JLabel" binding="lblSeccionDatos">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="DATOS DEL LABORATORIO"/>
                    </properties>
                  </component>
                  <component id="c0003" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="ID:"/>
                    </properties>
                  </component>
                  <component id="c0004" class="javax.swing.JTextField" binding="txtId">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c0005" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Código:"/>
                    </properties>
                  </component>
                  <component id="c0006" class="javax.swing.JTextField" binding="txtCodigo">
                    <constraints>
                      <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <toolTipText value="Código único del laboratorio, por ejemplo LAB-01"/>
                    </properties>
                  </component>
                  <component id="c0007" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Nombre:"/>
                    </properties>
                  </component>
                  <component id="c0008" class="javax.swing.JTextField" binding="txtNombre">
                    <constraints>
                      <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="c0009" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Ubicación (edificio/salón):"/>
                    </properties>
                  </component>
                  <component id="c000a" class="javax.swing.JTextField" binding="txtUbicacion">
                    <constraints>
                      <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="c000b" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Capacidad:"/>
                    </properties>
                  </component>
                  <component id="c000c" class="javax.swing.JSpinner" binding="spnCapacidad">
                    <constraints>
                      <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="c000d" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Estado:"/>
                    </properties>
                  </component>
                  <component id="c000e" class="javax.swing.JComboBox" binding="cmbEstado">
                    <constraints>
                      <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <model>
                        <item value="ACTIVO"/>
                        <item value="INACTIVO"/>
                      </model>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 4. ACCIONES -->
              <grid id="c0010" layout-manager="GridLayoutManager" row-count="1" column-count="7" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="0">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="c0011" class="javax.swing.JButton" binding="btnNuevo">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Nuevo"/>
                    </properties>
                  </component>
                  <component id="c0012" class="javax.swing.JButton" binding="btnGuardar">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Guardar"/>
                    </properties>
                  </component>
                  <component id="c0013" class="javax.swing.JButton" binding="btnActualizar">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Actualizar"/>
                    </properties>
                  </component>
                  <component id="c0014" class="javax.swing.JButton" binding="btnDesactivar">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Desactivar"/>
                    </properties>
                  </component>
                  <component id="c0015" class="javax.swing.JButton" binding="btnLimpiar">
                    <constraints>
                      <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Limpiar"/>
                    </properties>
                  </component>
                  <hspacer id="c0016">
                    <constraints>
                      <grid row="0" column="5" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                  </hspacer>
                  <component id="c0017" class="javax.swing.JButton" binding="btnRegresar">
                    <constraints>
                      <grid row="0" column="6" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Regresar"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 5. TARJETA: REGISTROS -->
              <grid id="regs" binding="cardRegistros" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="10">
                <margin top="16" left="20" bottom="20" right="20"/>
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secReg" class="javax.swing.JLabel" binding="lblSeccionRegistros">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="LABORATORIOS REGISTRADOS"/>
                    </properties>
                  </component>
                  <scrollpane id="c0024">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="260"/>
                      </grid>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="c0025" class="javax.swing.JTable" binding="tblLaboratorios">
                        <constraints/>
                        <properties/>
                      </component>
                    </children>
                  </scrollpane>
                </children>
              </grid>
              <!-- 6. INDICACIONES -->
              <component id="indic" class="javax.swing.JLabel" binding="lblIndicaciones">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Seleccione un laboratorio en la tabla para editarlo o desactivarlo. El código del laboratorio no puede repetirse."/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
