<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SIGELAB.view.FrmPrincipal">
  <grid id="root" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="1280" height="800"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>

      <!-- BARRA LATERAL CON SCROLL -->
      <scrollpane id="scrollMenu" binding="scrollNavegacion">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="1" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="255" height="700"/>
            <minimum-size width="220" height="100"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>

          <grid id="menu" binding="panelNavegacion" layout-manager="GridLayoutManager" row-count="20" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="5">
            <margin top="24" left="17" bottom="20" right="17"/>
            <constraints/>
            <properties>
              <background color="-14597150"/>
            </properties>
            <border type="none"/>
            <children>

              <component id="marca" class="javax.swing.JLabel" binding="lblMarca">
