<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SIGELAB.view.FrmPrincipal">
  <grid id="c0000" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="1150" height="750"/>
    </constraints>
    <properties>
      <minimumSize width="900" height="650"/>
      <preferredSize width="1150" height="750"/>
    </properties>
    <border type="none"/>
    <children>

      <!-- ================================== -->
      <!-- NAVEGACION LATERAL -->
      <!-- ================================== -->

      <grid id="c0001" binding="panelNavegacion" layout-manager="GridLayoutManager" row-count="14" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="7">
        <margin top="25" left="15" bottom="20" right="15"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="240" height="-1"/>
            <minimum-size width="200" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <background color="-15655630"/>
        </properties>
        <border type="none"/>
        <children>

          <!-- MARCA -->
          <component id="c0002" class="javax.swing.JLabel" binding="lblMarca">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="55"/>
              </grid>
            </constraints>
            <properties>
              <font name="Arial" size="22" style="1"/>
              <foreground color="-1"/>
              <text value="SIGELAB"/>
            </properties>
          </component>

          <!-- PRESTAMOS -->
          <component id="c0003" class="javax.swing.JButton" binding="btnPrestamos">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <text value="Préstamos"/>
            </properties>
          </component>

          <!-- DEVOLUCIONES -->
          <component id="c0004" class="javax.swing.JButton" binding="btnDevoluciones">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <text value="Devoluciones"/>
            </properties>
          </component>

          <!-- EQUIPOS -->
          <component id="c0005" class="javax.swing.JButton" binding="btnEquipos">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <text value="Equipos"/>
            </properties>
          </component>

          <!-- TIPOS DE EQUIPO -->
          <component id="c0006" class="javax.swing.JButton" binding="btnTiposEquipo">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <text value="Tipos de equipo"/>
            </properties>
          </component>

          <!-- LABORATORIOS -->
          <component id="c0007" class="javax.swing.JButton" binding="btnLaboratorios">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <text value="Laboratorios"/>
            </properties>
          </component>

          <!-- SOLICITANTES -->
          <component id="c0008" class="javax.swing.JButton" binding="btnSolicitantes">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <text value="Solicitantes"/>
            </properties>
          </component>

          <!-- MANTENIMIENTO -->
          <component id="c0009" class="javax.swing.JButton" binding="btnMantenimiento">
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <text value="Mantenimiento"/>
            </properties>
          </component>

          <!-- REPORTES -->
          <component id="c000a" class="javax.swing.JButton" binding="btnReportes">
            <constraints>
              <grid row="8" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <text value="Reportes"/>
            </properties>
          </component>

          <!-- USUARIOS -->
          <component id="c000b" class="javax.swing.JButton" binding="btnUsuarios">
            <constraints>
              <grid row="9" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <text value="Usuarios"/>
            </properties>
          </component>

          <!-- AUDITORIA -->
          <component id="c000c" class="javax.swing.JButton" binding="btnAuditoria">
            <constraints>
              <grid row="10" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <text value="Auditoría"/>
            </properties>
          </component>

          <!-- ESPACIO FLEXIBLE -->
          <vspacer id="c000d">
            <constraints>
              <grid row="11" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>

          <!-- CERRAR SESION -->
          <component id="c000e" class="javax.swing.JButton" binding="btnCerrarSesion">
            <constraints>
              <grid row="12" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <text value="Cerrar sesión"/>
            </properties>
          </component>

          <!-- SALIR -->
          <component id="c000f" class="javax.swing.JButton" binding="btnSalir">
            <constraints>
              <grid row="13" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <text value="Salir"/>
            </properties>
          </component>

        </children>
      </grid>

      <!-- ================================== -->
      <!-- CONTENIDO PRINCIPAL -->
      <!-- ================================== -->

      <grid id="c0010" binding="panelContenido" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="18">
        <margin top="30" left="30" bottom="25" right="30"/>
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-15920606"/>
        </properties>
        <border type="none"/>
        <children>

          <!-- ENCABEZADO -->
          <grid id="c0011" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="15" vgap="0">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children>

              <component id="c0012" class="javax.swing.JLabel" binding="lblTitulo">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Arial" size="26" style="1"/>
                  <text value="Panel de control"/>
                </properties>
              </component>

              <component id="c0013" class="javax.swing.JCheckBox" binding="chkModoOscuro">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Arial" size="12" style="1"/>
                  <opaque value="false"/>
                  <selected value="true"/>
                  <text value="Modo oscuro"/>
                </properties>
              </component>

            </children>
          </grid>

          <!-- USUARIO CONECTADO -->
          <component id="c0014" class="javax.swing.JLabel" binding="lblUsuarioActual">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="13"/>
              <text value="Usuario: (sin sesión)"/>
            </properties>
          </component>

          <!-- DASHBOARD -->
          <grid id="c0015" binding="panelResumen" layout-manager="GridLayoutManager" row-count="4" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="18" vgap="24">
            <margin top="25" left="25" bottom="25" right="25"/>
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="etched" title="Resumen general del sistema"/>
            <children>

              <component id="c0016" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Total de equipos"/>
                </properties>
              </component>

              <component id="c0017" class="javax.swing.JLabel" binding="lblTotalEquipos">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Arial" size="22" style="1"/>
                  <text value="0"/>
                </properties>
              </component>

              <component id="c0018" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Disponibles"/>
                </properties>
              </component>

              <component id="c0019" class="javax.swing.JLabel" binding="lblDisponibles">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Arial" size="22" style="1"/>
                  <text value="0"/>
                </properties>
              </component>

              <component id="c001a" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Prestados"/>
                </properties>
              </component>

              <component id="c001b" class="javax.swing.JLabel" binding="lblPrestados">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Arial" size="22" style="1"/>
                  <text value="0"/>
                </properties>
              </component>

              <component id="c001c" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Dañados"/>
                </properties>
              </component>

              <component id="c001d" class="javax.swing.JLabel" binding="lblDanados">
                <constraints>
                  <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Arial" size="22" style="1"/>
                  <text value="0"/>
                </properties>
              </component>

              <component id="c001e" class="javax.swing.JLabel">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="En mantenimiento"/>
                </properties>
              </component>

              <component id="c001f" class="javax.swing.JLabel" binding="lblMantenimiento">
                <constraints>
                  <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Arial" size="22" style="1"/>
                  <text value="0"/>
                </properties>
              </component>

              <component id="c0020" class="javax.swing.JLabel">
                <constraints>
                  <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="De baja"/>
                </properties>
              </component>

              <component id="c0021" class="javax.swing.JLabel" binding="lblBaja">
                <constraints>
                  <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Arial" size="22" style="1"/>
                  <text value="0"/>
                </properties>
              </component>

              <component id="c0022" class="javax.swing.JLabel">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Préstamos activos"/>
                </properties>
              </component>

              <component id="c0023" class="javax.swing.JLabel" binding="lblPrestamosActivos">
                <constraints>
                  <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Arial" size="22" style="1"/>
                  <text value="0"/>
                </properties>
              </component>

              <component id="c0024" class="javax.swing.JLabel">
                <constraints>
                  <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Préstamos vencidos"/>
                </properties>
              </component>

              <component id="c0025" class="javax.swing.JLabel" binding="lblPrestamosVencidos">
                <constraints>
                  <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Arial" size="22" style="1"/>
                  <text value="0"/>
                </properties>
              </component>

            </children>
          </grid>

          <!-- ACTUALIZAR DASHBOARD -->
          <component id="c0026" class="javax.swing.JButton" binding="btnActualizarResumen">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="190" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Actualizar resumen"/>
            </properties>
          </component>

        </children>
