<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SIGELAB.view.FrmPrincipal">
  <grid id="c0001" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="600" height="450"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="c0002" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="20" style="1"/>
          <text value="SIGELAB - Menú principal"/>
        </properties>
      </component>
      <component id="c0003" class="javax.swing.JLabel" binding="lblUsuarioActual">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Usuario: (sin sesión)"/>
        </properties>
      </component>
      <grid id="c0004" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Módulos"/>
        <children>
          <component id="c0005" class="javax.swing.JButton" binding="btnPrestamos">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Préstamos"/>
            </properties>
          </component>
          <component id="c0006" class="javax.swing.JButton" binding="btnDevoluciones">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Devoluciones"/>
            </properties>
          </component>
          <component id="c0007" class="javax.swing.JButton" binding="btnEquipos">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Equipos"/>
            </properties>
          </component>
          <component id="c0008" class="javax.swing.JButton" binding="btnTiposEquipo">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Tipos de equipo"/>
            </properties>
          </component>
          <component id="c0009" class="javax.swing.JButton" binding="btnLaboratorios">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Laboratorios"/>
            </properties>
          </component>
          <component id="c000a" class="javax.swing.JButton" binding="btnSolicitantes">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Solicitantes"/>
            </properties>
          </component>
          <component id="c000b" class="javax.swing.JButton" binding="btnMantenimiento">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Mantenimiento"/>
            </properties>
          </component>
          <component id="c000c" class="javax.swing.JButton" binding="btnReportes">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Reportes"/>
            </properties>
          </component>
          <component id="c000d" class="javax.swing.JButton" binding="btnUsuarios">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Usuarios"/>
            </properties>
          </component>
          <component id="c000e" class="javax.swing.JButton" binding="btnAuditoria">
            <constraints>
              <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Auditoría"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="c000f" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <hspacer id="c0010">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <component id="c0011" class="javax.swing.JButton" binding="btnCerrarSesion">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Cerrar sesión"/>
            </properties>
          </component>
          <component id="c0012" class="javax.swing.JButton" binding="btnSalir">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Salir"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
