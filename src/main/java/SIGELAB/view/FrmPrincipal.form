                </constraints>
                <properties><text value="OPERACIONES"/></properties>
              </component>

              <component id="prestamos" class="javax.swing.JButton" binding="btnPrestamos">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-460552"/>
                  <text value="Préstamos"/>
                </properties>
              </component>

              <component id="devoluciones" class="javax.swing.JButton" binding="btnDevoluciones">
