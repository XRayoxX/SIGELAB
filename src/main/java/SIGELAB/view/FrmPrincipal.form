                  <grid row="10" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-460552"/>
                  <text value="Tipos de equipo"/>
                </properties>
              </component>

              <component id="laboratorios" class="javax.swing.JButton" binding="btnLaboratorios">
                <constraints>
                  <grid row="11" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-460552"/>
                  <text value="Laboratorios"/>
                </properties>
              </component>

              <component id="solicitantes" class="javax.swing.JButton" binding="btnSolicitantes">
                <constraints>
                  <grid row="12" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-460552"/>
                  <text value="Solicitantes"/>
                </properties>
              </component>

              <component id="gestion" class="javax.swing.JLabel" binding="lblGestion">
                <constraints>
                  <grid row="13" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties><text value="GESTIÓN Y SEGURIDAD"/></properties>
              </component>

              <component id="reportes" class="javax.swing.JButton" binding="btnReportes">
