                </constraints>
                <properties><text value="GESTIÓN DE LABORATORIOS"/></properties>
              </component>

              <component id="general" class="javax.swing.JLabel" binding="lblGeneral">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties><text value="GENERAL"/></properties>
              </component>

              <component id="dashboard" class="javax.swing.JLabel" binding="lblDashboardMenu">
