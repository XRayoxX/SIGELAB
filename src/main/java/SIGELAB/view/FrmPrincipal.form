                  <grid row="14" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-460552"/>
                  <text value="Reportes"/>
                </properties>
              </component>

              <component id="usuarios" class="javax.swing.JButton" binding="btnUsuarios">
                <constraints>
                  <grid row="15" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-460552"/>
