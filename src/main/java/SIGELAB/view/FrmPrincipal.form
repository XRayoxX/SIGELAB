                </constraints>
                <properties>
                  <background color="-460552"/>
                  <text value="Auditoría"/>
                </properties>
              </component>

              <component id="espacio" class="javax.swing.JLabel">
                <constraints>
                  <grid row="17" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <minimum-size width="-1" height="18"/>
                  </grid>
                </constraints>
                <properties><text value=""/></properties>
              </component>

              <component id="cerrar" class="javax.swing.JButton" binding="btnCerrarSesion">
                <constraints>
                  <grid row="18" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-460552"/>
                  <text value="Cerrar sesión"/>
                </properties>
              </component>

              <component id="salir" class="javax.swing.JButton" binding="btnSalir">
                <constraints>
                  <grid row="19" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-460552"/>
                  <text value="Salir de SIGELAB"/>
                </properties>
              </component>

            </children>
          </grid>
        </children>
      </scrollpane>

      <!-- ÁREA CENTRAL CON SCROLL -->
      <scrollpane id="scrollCentro" binding="scrollContenido">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>

          <grid id="contenido" binding="panelContenido" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="14">
            <margin top="25" left="28" bottom="26" right="28"/>
            <constraints/>
            <properties>
              <background color="-3289651"/>
            </properties>
            <border type="none"/>
            <children>

              <!-- CABECERA -->
              <grid id="cabecera" binding="panelEncabezado" layout-manager="GridLayoutManager" row-count="3" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="7">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>

                  <component id="titulo" class="javax.swing.JLabel" binding="lblTitulo">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="1" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties><text value="Centro de control"/></properties>
                  </component>

                  <component id="sol" class="javax.swing.JButton" binding="btnModoClaro">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="1" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="43" height="35"/>
                      </grid>
                    </constraints>
                    <properties>
          <background color="-460552"/>
          <text value="☀"/>
        </properties>
                  </component>

                  <component id="luna" class="javax.swing.JButton" binding="btnModoOscuro">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="1" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="43" height="35"/>
                      </grid>
                    </constraints>
                    <properties>
                      <background color="-460552"/>
                      <text value="☾"/>
                    </properties>
                  </component>

                  <component id="usuario" class="javax.swing.JLabel" binding="lblUsuarioActual">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="4" vsize-policy="1" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties><text value="Usuario actual"/></properties>
                  </component>

                  <component id="resumen" class="javax.swing.JLabel" binding="lblTituloResumen">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="1" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties><text value="RESUMEN GENERAL DEL SISTEMA"/></properties>
                  </component>

                  <component id="actualizar" class="javax.swing.JButton" binding="btnActualizarResumen">
                    <constraints>
                      <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="1" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <background color="-460552"/>
                      <text value="Actualizar"/>
                    </properties>
                  </component>

                </children>
              </grid>

              <!-- TARJETAS PRINCIPALES -->
              <grid id="tarjetasPrincipal" binding="panelIndicadores" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="true" same-size-vertically="false" hgap="12" vgap="0">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>

                  <grid id="cardTotal" binding="cardTotal" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="8">
                    <margin top="17" left="18" bottom="17" right="12"/>
                    <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties/><border type="none"/>
                    <children>
                      <component id="labTotal" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="TOTAL DE EQUIPOS"/></properties></component>
                      <component id="valTotal" class="javax.swing.JLabel" binding="lblTotalEquipos"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="0"/></properties></component>
                    </children>
                  </grid>

                  <grid id="cardDisponible" binding="cardDisponibles" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="8">
                    <margin top="17" left="18" bottom="17" right="12"/>
                    <constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties/><border type="none"/>
                    <children>
                      <component id="labDisponible" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="DISPONIBLES"/></properties></component>
                      <component id="valDisponible" class="javax.swing.JLabel" binding="lblDisponibles"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="0"/></properties></component>
                    </children>
                  </grid>

                  <grid id="cardPrestado" binding="cardPrestados" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="8">
                    <margin top="17" left="18" bottom="17" right="12"/>
                    <constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties/><border type="none"/>
                    <children>
                      <component id="labPrestado" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="PRESTADOS"/></properties></component>
                      <component id="valPrestado" class="javax.swing.JLabel" binding="lblPrestados"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="0"/></properties></component>
                    </children>
                  </grid>

                  <grid id="cardMant" binding="cardMantenimiento" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="8">
                    <margin top="17" left="18" bottom="17" right="12"/>
                    <constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties/><border type="none"/>
                    <children>
                      <component id="labMant" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="MANTENIMIENTO"/></properties></component>
                      <component id="valMant" class="javax.swing.JLabel" binding="lblMantenimiento"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="0"/></properties></component>
                    </children>
                  </grid>

                </children>
              </grid>

              <!-- DISTRIBUCIÓN COMPACTA -->
              <grid id="inventario" binding="panelInventario" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="18" vgap="7">
                <margin top="18" left="20" bottom="18" right="20"/>
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>

                  <component id="tituloInv" class="javax.swing.JLabel" binding="lblTituloInventario">
                    <constraints><grid row="0" column="0" row-span="1" col-span="2" vsize-policy="1" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties><text value="Distribución del inventario"/></properties>
                  </component>

                  <component id="subInv" class="javax.swing.JLabel" binding="lblDescripcionInventario">
                    <constraints><grid row="1" column="0" row-span="1" col-span="2" vsize-policy="1" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties><text value="Estado general de los equipos registrados"/></properties>
                  </component>

                  <component id="txtDisp" class="javax.swing.JLabel">
                    <constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties><text value="Disponibles"/></properties>
                  </component>
                  <component id="barDisp" class="javax.swing.JProgressBar" binding="barDisponibles">
                    <constraints><grid row="2" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties/>
                  </component>

                  <component id="txtPres" class="javax.swing.JLabel">
                    <constraints><grid row="3" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties><text value="Prestados"/></properties>
                  </component>
                  <component id="barPres" class="javax.swing.JProgressBar" binding="barPrestados">
                    <constraints><grid row="3" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties/>
                  </component>

                  <component id="txtDan" class="javax.swing.JLabel">
                    <constraints><grid row="4" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties><text value="Dañados"/></properties>
                  </component>
                  <component id="barDan" class="javax.swing.JProgressBar" binding="barDanados">
                    <constraints><grid row="4" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties/>
                  </component>

                  <component id="txtMan" class="javax.swing.JLabel">
                    <constraints><grid row="5" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties><text value="Mantenimiento"/></properties>
                  </component>
                  <component id="barMan" class="javax.swing.JProgressBar" binding="barMantenimiento">
                    <constraints><grid row="5" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties/>
                  </component>

                  <component id="txtBaja" class="javax.swing.JLabel">
                    <constraints><grid row="6" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties><text value="De baja"/></properties>
                  </component>
                  <component id="barBaja" class="javax.swing.JProgressBar" binding="barBaja">
                    <constraints><grid row="6" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
                    <properties/>
                  </component>

                </children>
              </grid>

              <!-- TARJETAS SECUNDARIAS -->
              <grid id="seguimiento" binding="panelIndicadoresSecundarios" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="true" same-size-vertically="false" hgap="12" vgap="12">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>

                  <component id="tituloSeg" class="javax.swing.JLabel" binding="lblTituloSecundarios">
                    <constraints><grid row="0" column="0" row-span="1" col-span="4" vsize-policy="1" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
