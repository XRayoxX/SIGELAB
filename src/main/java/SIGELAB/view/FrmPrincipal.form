                <properties>
                  <background color="-460552"/>
                  <text value="Equipos"/>
                </properties>
              </component>

              <component id="mantenimiento" class="javax.swing.JButton" binding="btnMantenimiento">
                <constraints>
                  <grid row="8" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-460552"/>
                  <text value="Mantenimiento"/>
                </properties>
              </component>

              <component id="catalogos" class="javax.swing.JLabel" binding="lblCatalogos">
                <constraints>
