<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/"
      version="1"
      bind-to-class="SIGELAB.view.FrmCalendario">

  <grid id="raiz"
        binding="panelPrincipal"
        layout-manager="GridLayoutManager"
        row-count="3"
        column-count="1"
        same-size-horizontally="false"
        same-size-vertically="false"
        hgap="0"
        vgap="12">

    <margin top="18" left="18"
            bottom="18" right="18"/>

    <constraints>
      <xy x="20" y="20" width="390" height="390"/>
    </constraints>

    <properties/>
    <border type="none"/>

    <children>

      <grid id="navegacion"
            layout-manager="GridLayoutManager"
            row-count="1"
            column-count="3"
            same-size-horizontally="false"
            same-size-vertically="false"
            hgap="10"
            vgap="0">

        <margin top="0" left="0"
                bottom="0" right="0"/>

        <constraints>
          <grid row="0" column="0"
                row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="7"
                anchor="0" fill="3"
                indent="0"
                use-parent-layout="false"/>
        </constraints>

        <properties/>
        <border type="none"/>

        <children>

          <component id="anterior"
                     class="javax.swing.JButton"
                     binding="btnAnterior">
            <constraints>
              <grid row="0" column="0"
                    row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0"
                    anchor="4" fill="0"
                    indent="0"
                    use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="&lt;"/>
            </properties>
          </component>

          <component id="mes"
                     class="javax.swing.JLabel"
                     binding="lblMes">
            <constraints>
              <grid row="0" column="1"
                    row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="7"
                    anchor="0" fill="1"
                    indent="0"
                    use-parent-layout="false"/>
            </constraints>
            <properties>
              <horizontalAlignment value="0"/>
              <text value="Mes y año"/>
            </properties>
          </component>

          <component id="siguiente"
                     class="javax.swing.JButton"
                     binding="btnSiguiente">
            <constraints>
              <grid row="0" column="2"
                    row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0"
                    anchor="4" fill="0"
                    indent="0"
                    use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="&gt;"/>
            </properties>
          </component>

        </children>
      </grid>

      <grid id="dias"
            binding="panelDias"
            layout-manager="GridLayoutManager"
            row-count="1"
            column-count="1"
            same-size-horizontally="false"
            same-size-vertically="false"
            hgap="0"
            vgap="0">

        <margin top="0" left="0"
                bottom="0" right="0"/>

        <constraints>
          <grid row="1" column="0"
                row-span="1" col-span="1"
                vsize-policy="7" hsize-policy="7"
                anchor="0" fill="3"
                indent="0"
                use-parent-layout="false">
            <preferred-size width="340" height="260"/>
          </grid>
        </constraints>

        <properties/>
        <border type="none"/>
        <children/>

      </grid>

      <grid id="acciones"
            layout-manager="GridLayoutManager"
            row-count="1"
            column-count="2"
            same-size-horizontally="false"
            same-size-vertically="false"
            hgap="10"
            vgap="0">

        <margin top="0" left="0"
                bottom="0" right="0"/>

        <constraints>
          <grid row="2" column="0"
                row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="7"
                anchor="0" fill="3"
                indent="0"
                use-parent-layout="false"/>
        </constraints>

        <properties/>
        <border type="none"/>

        <children>

          <component id="hoy"
                     class="javax.swing.JButton"
                     binding="btnHoy">
            <constraints>
              <grid row="0" column="0"
                    row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="7"
                    anchor="0" fill="1"
                    indent="0"
                    use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Hoy"/>
            </properties>
          </component>

          <component id="cancelar"
                     class="javax.swing.JButton"
                     binding="btnCancelar">
            <constraints>
              <grid row="0" column="1"
                    row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="7"
                    anchor="0" fill="1"
                    indent="0"
                    use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Cancelar"/>
            </properties>
          </component>

        </children>
      </grid>

    </children>
  </grid>
</form>
