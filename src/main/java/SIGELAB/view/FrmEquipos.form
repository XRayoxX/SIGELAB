                    </properties>
                  </component>
                  <component id="c0020" class="javax.swing.JButton" binding="btnActualizar">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
