<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SIGELAB.view.FrmEquipos">
  <grid id="c0000" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="1180" height="860"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="scroll" binding="scrollContenido">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="contenido" layout-manager="GridLayoutManager" row-count="6" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="14">
            <margin top="24" left="28" bottom="24" right="28"/>
            <constraints/>
            <properties>
              <background color="-3289651"/>
            </properties>
            <border type="none"/>
            <children>
              <!-- 1. ENCABEZADO DEL MÓDULO -->
              <grid id="cabecera" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="4">
                <margin top="0" left="0" bottom="4" right="0"/>
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="c0001" class="javax.swing.JLabel" binding="lblTitulo">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Gestión de Equipos"/>
                    </properties>
                  </component>
                  <component id="btnSol" class="javax.swing.JButton" binding="btnModoClaro">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="43" height="35"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="☀"/>
                      <toolTipText value="Modo claro"/>
                    </properties>
                  </component>
                  <component id="btnLuna" class="javax.swing.JButton" binding="btnModoOscuro">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="43" height="35"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="☾"/>
                      <toolTipText value="Modo oscuro"/>
                    </properties>
                  </component>
                  <component id="subtitulo" class="javax.swing.JLabel" binding="lblSubtitulo">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="INVENTARIO  |  Registro de equipos, laboratorio asignado, estado actual y código QR"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 2. TARJETA: BÚSQUEDA Y FILTROS -->
              <grid id="c0025" binding="cardBusqueda" layout-manager="GridLayoutManager" row-count="2" column-count="7" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
                <margin top="16" left="20" bottom="16" right="20"/>
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secBus" class="javax.swing.JLabel" binding="lblSeccionBusqueda">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="7" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="BÚSQUEDA Y FILTROS"/>
                    </properties>
                  </component>
                  <component id="c0026" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Buscar:"/>
                    </properties>
                  </component>
                  <component id="c0027" class="javax.swing.JTextField" binding="txtBuscar">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="220" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <toolTipText value="Código, nombre, marca o modelo del equipo"/>
                    </properties>
                  </component>
                  <component id="c0028" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Estado:"/>
                    </properties>
                  </component>
                  <component id="c0029" class="javax.swing.JComboBox" binding="cmbFiltroEstado">
                    <constraints>
                      <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="160" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <model>
                        <item value="TODOS"/>
                        <item value="DISPONIBLE"/>
                        <item value="PRESTADO"/>
                        <item value="DANADO"/>
                        <item value="MANTENIMIENTO"/>
                        <item value="BAJA"/>
                      </model>
                    </properties>
                  </component>
                  <component id="c002a" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Laboratorio:"/>
                    </properties>
                  </component>
                  <component id="c002b" class="javax.swing.JComboBox" binding="cmbFiltroLaboratorio">
                    <constraints>
                      <grid row="1" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="200" height="34"/>
                      </grid>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="c002c" class="javax.swing.JButton" binding="btnBuscar">
                    <constraints>
                      <grid row="1" column="6" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="110" height="36"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Buscar"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 3. CUERPO: DATOS DEL EQUIPO + CÓDIGO QR -->
              <grid id="cuerpo" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="14" vgap="0">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <grid id="c0002" binding="cardDatos" layout-manager="GridLayoutManager" row-count="7" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="14" vgap="10">
                    <margin top="18" left="20" bottom="18" right="20"/>
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="secDat" class="javax.swing.JLabel" binding="lblSeccionDatos">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="INFORMACIÓN DEL EQUIPO"/>
                        </properties>
                      </component>
                      <component id="c0003" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="ID:"/>
                        </properties>
                      </component>
                      <component id="c0004" class="javax.swing.JTextField" binding="txtId">
                        <constraints>
                          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="180" height="34"/>
                          </grid>
                        </constraints>
                        <properties>
                          <editable value="false"/>
                        </properties>
                      </component>
                      <component id="c0005" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Código de inventario:"/>
                        </properties>
                      </component>
                      <component id="c0006" class="javax.swing.JTextField" binding="txtCodigoInventario">
                        <constraints>
                          <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="180" height="34"/>
                          </grid>
                        </constraints>
                        <properties>
                          <toolTipText value="Código único, por ejemplo CAM-001 (es el valor del QR)"/>
                        </properties>
                      </component>
                      <component id="c0007" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Nombre:"/>
                        </properties>
                      </component>
                      <component id="c0008" class="javax.swing.JTextField" binding="txtNombre">
                        <constraints>
                          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="180" height="34"/>
                          </grid>
                        </constraints>
                        <properties/>
                      </component>
                      <component id="c0009" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Tipo de equipo:"/>
                        </properties>
                      </component>
                      <component id="c000a" class="javax.swing.JComboBox" binding="cmbTipoEquipo">
                        <constraints>
                          <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="180" height="34"/>
                          </grid>
                        </constraints>
                        <properties/>
                      </component>
                      <component id="c000b" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Marca:"/>
                        </properties>
                      </component>
                      <component id="c000c" class="javax.swing.JTextField" binding="txtMarca">
                        <constraints>
                          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="180" height="34"/>
                          </grid>
                        </constraints>
                        <properties/>
                      </component>
                      <component id="c000d" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Modelo:"/>
                        </properties>
                      </component>
                      <component id="c000e" class="javax.swing.JTextField" binding="txtModelo">
                        <constraints>
                          <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="180" height="34"/>
                          </grid>
                        </constraints>
                        <properties/>
                      </component>
                      <component id="c000f" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Número de serie:"/>
                        </properties>
                      </component>
                      <component id="c0010" class="javax.swing.JTextField" binding="txtNumeroSerie">
                        <constraints>
                          <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="180" height="34"/>
                          </grid>
                        </constraints>
                        <properties/>
                      </component>
                      <component id="c0011" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="4" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Laboratorio:"/>
                        </properties>
                      </component>
                      <component id="c0012" class="javax.swing.JComboBox" binding="cmbLaboratorio">
                        <constraints>
                          <grid row="4" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="180" height="34"/>
                          </grid>
                        </constraints>
                        <properties/>
                      </component>
                      <component id="c0013" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Estado:"/>
                        </properties>
                      </component>
                      <component id="c0014" class="javax.swing.JComboBox" binding="cmbEstado">
                        <constraints>
                          <grid row="5" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="180" height="34"/>
                          </grid>
                        </constraints>
                        <properties>
                          <enabled value="false"/>
                          <model>
                            <item value="DISPONIBLE"/>
                            <item value="PRESTADO"/>
                            <item value="DANADO"/>
                            <item value="MANTENIMIENTO"/>
                            <item value="BAJA"/>
                          </model>
                          <toolTipText value="El estado cambia solo con préstamos, devoluciones y mantenimiento"/>
                        </properties>
                      </component>
                      <component id="c0015" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Observaciones:"/>
                        </properties>
                      </component>
                      <scrollpane id="c0016">
                        <constraints>
                          <grid row="6" column="1" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                            <preferred-size width="-1" height="70"/>
                          </grid>
                        </constraints>
                        <properties/>
                        <border type="none"/>
                        <children>
                          <component id="c0017" class="javax.swing.JTextArea" binding="txaObservaciones">
                            <constraints/>
                            <properties>
                              <lineWrap value="true"/>
                              <rows value="3"/>
                              <wrapStyleWord value="true"/>
                            </properties>
                          </component>
                        </children>
                      </scrollpane>
                    </children>
                  </grid>
                  <grid id="c0018" binding="cardQr" layout-manager="GridLayoutManager" row-count="5" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="10">
                    <margin top="18" left="20" bottom="18" right="20"/>
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="1" anchor="0" fill="3" indent="0" use-parent-layout="false">
                        <preferred-size width="240" height="-1"/>
                      </grid>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="secQr" class="javax.swing.JLabel" binding="lblSeccionQr">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="CÓDIGO QR DEL EQUIPO"/>
                        </properties>
                      </component>
                      <component id="c0019" class="javax.swing.JLabel" binding="lblCodigoQr">
                        <constraints>
                          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                            <preferred-size width="150" height="150"/>
                          </grid>
                        </constraints>
                        <properties>
                          <horizontalAlignment value="0"/>
                          <text value="(sin QR)"/>
                        </properties>
                      </component>
                      <component id="c001a" class="javax.swing.JButton" binding="btnGenerarQr">
                        <constraints>
                          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="-1" height="36"/>
                          </grid>
                        </constraints>
                        <properties>
                          <text value="Generar QR"/>
                        </properties>
                      </component>
                      <component id="c001b" class="javax.swing.JButton" binding="btnGuardarQr">
                        <constraints>
                          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="-1" height="36"/>
                          </grid>
                        </constraints>
                        <properties>
                          <text value="Guardar imagen QR"/>
                        </properties>
                      </component>
                      <vspacer id="c001c">
                        <constraints>
                          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                        </constraints>
                      </vspacer>
                    </children>
                  </grid>
                </children>
              </grid>
              <!-- 4. ACCIONES -->
              <grid id="c001d" layout-manager="GridLayoutManager" row-count="1" column-count="7" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="0">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="c001e" class="javax.swing.JButton" binding="btnNuevo">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Nuevo"/>
                    </properties>
                  </component>
                  <component id="c001f" class="javax.swing.JButton" binding="btnGuardar">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
