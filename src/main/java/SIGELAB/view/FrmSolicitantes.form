            <properties>
              <text value="Nuevo"/>
            </properties>
          </component>
          <component id="c0015" class="javax.swing.JButton" binding="btnGuardar">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Guardar"/>
            </properties>
          </component>
          <component id="c0016" class="javax.swing.JButton" binding="btnActualizar">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Actualizar"/>
            </properties>
          </component>
          <component id="c0017" class="javax.swing.JButton" binding="btnDesactivar">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Desactivar"/>
            </properties>
          </component>
          <component id="c0018" class="javax.swing.JButton" binding="btnLimpiar">
