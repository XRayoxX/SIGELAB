      </grid>
      <scrollpane id="c0020">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="250"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="c0021" class="javax.swing.JTable" binding="tblSolicitantes">
            <constraints/>
