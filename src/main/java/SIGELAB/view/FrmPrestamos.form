        </constraints>
        <properties>
          <font size="18" style="1"/>
          <text value="Préstamos de Equipo"/>
        </properties>
      </component>
      <grid id="c0002" layout-manager="GridLayoutManager" row-count="4" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Encabezado del préstamo"/>
        <children>
          <component id="c0003" class="javax.swing.JLabel">
            <constraints>
