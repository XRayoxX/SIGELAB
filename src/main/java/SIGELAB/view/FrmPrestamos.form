<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SIGELAB.view.FrmPrestamos">
  <grid id="c0000" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="1180" height="840"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="scrollRoot" binding="scrollContenido">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="contenido" binding="panelContenido" layout-manager="GridLayoutManager" row-count="6" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="14">
            <margin top="24" left="28" bottom="26" right="28"/>
            <constraints/>
            <properties/>
            <border type="none"/>
            <children>

              <!-- 1. CABECERA DEL MÓDULO -->
              <grid id="cabecera" binding="panelEncabezado" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="4">
                <margin top="0" left="0" bottom="4" right="0"/>
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="c0001" class="javax.swing.JLabel" binding="lblTitulo">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Préstamos de Equipo"/>
                    </properties>
                  </component>
                  <component id="btnSol" class="javax.swing.JButton" binding="btnModoClaro">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="1" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="43" height="35"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="☀"/>
                    </properties>
                  </component>
                  <component id="btnLuna" class="javax.swing.JButton" binding="btnModoOscuro">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="1" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="43" height="35"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="☾"/>
                    </properties>
                  </component>
                  <component id="subtitulo" class="javax.swing.JLabel" binding="lblSubtitulo">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="OPERACIONES DE LABORATORIO  |  Registro de salidas, asignación por código o QR y consulta histórica"/>
                    </properties>
                  </component>
                </children>
              </grid>

              <!-- 2. TARJETA: ENCABEZADO DEL PRÉSTAMO -->
              <grid id="c0002" binding="cardEncabezadoPrestamo" layout-manager="GridLayoutManager" row-count="5" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="14" vgap="10">
                <margin top="18" left="20" bottom="18" right="20"/>
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secEnc" class="javax.swing.JLabel" binding="lblSeccionEncabezado">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="INFORMACIÓN DEL PRÉSTAMO"/>
                    </properties>
                  </component>
                  <component id="c0003" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="No. de préstamo:"/>
                    </properties>
                  </component>
                  <component id="c0004" class="javax.swing.JTextField" binding="txtNoPrestamo">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="32"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c0005" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Estado:"/>
                    </properties>
                  </component>
                  <component id="c0006" class="javax.swing.JTextField" binding="txtEstado">
                    <constraints>
                      <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="32"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c0007" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Solicitante:"/>
                    </properties>
                  </component>
                  <component id="c0008" class="javax.swing.JComboBox" binding="cmbSolicitante">
                    <constraints>
                      <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="32"/>
                      </grid>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="c0009" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Registrado por:"/>
                    </properties>
                  </component>
                  <component id="c000a" class="javax.swing.JTextField" binding="txtUsuarioRegistra">
                    <constraints>
                      <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="32"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c000b" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Fecha de préstamo:"/>
                    </properties>
                  </component>
                  <component id="c000c" class="javax.swing.JTextField" binding="txtFechaPrestamo">
                    <constraints>
                      <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="32"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c000d" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Fecha esperada de devolución:"/>
                    </properties>
                  </component>
                  <component id="c000e" class="javax.swing.JTextField" binding="txtFechaEsperadaDevolucion">
                    <constraints>
                      <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="32"/>
                      </grid>
                    </constraints>
                    <properties>
                      <toolTipText value="Formato: dd/MM/yyyy"/>
                    </properties>
                  </component>
                  <component id="c000f" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Observaciones:"/>
                    </properties>
                  </component>
                  <scrollpane id="c0010" binding="scrollObservaciones">
                    <constraints>
                      <grid row="4" column="1" row-span="1" col-span="3" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="60"/>
                      </grid>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="c0011" class="javax.swing.JTextArea" binding="txaObservaciones">
                        <constraints/>
                        <properties>
                          <lineWrap value="true"/>
                          <rows value="2"/>
                          <wrapStyleWord value="true"/>
                        </properties>
                      </component>
                    </children>
                  </scrollpane>
                </children>
              </grid>

              <!-- 3. TARJETA: AGREGAR EQUIPOS AL PRÉSTAMO -->
              <grid id="c0012" binding="cardAgregarEquipos" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="14" vgap="10">
                <margin top="16" left="20" bottom="16" right="20"/>
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secAgr" class="javax.swing.JLabel" binding="lblSeccionAgregar">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="AGREGAR EQUIPOS AL PRÉSTAMO"/>
                    </properties>
                  </component>
                  <component id="c0013" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Código de inventario:"/>
                    </properties>
                  </component>
                  <grid id="c0014" binding="panelControlesEquipo" layout-manager="GridLayoutManager" row-count="1" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="0">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="c0015" class="javax.swing.JTextField" binding="txtCodigoEquipo">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="240" height="34"/>
                          </grid>
                        </constraints>
                        <properties>
                          <toolTipText value="Escriba el código o léalo desde el QR"/>
                        </properties>
                      </component>
                      <component id="c0016" class="javax.swing.JButton" binding="btnLeerQr">
                        <constraints>
                          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Leer QR..."/>
                        </properties>
                      </component>
                      <component id="c0017" class="javax.swing.JButton" binding="btnAgregarEquipo">
                        <constraints>
                          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Agregar equipo"/>
                        </properties>
                      </component>
                      <component id="c0018" class="javax.swing.JButton" binding="btnQuitarEquipo">
                        <constraints>
                          <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Quitar equipo"/>
                        </properties>
                      </component>
                      <hspacer id="c0019">
                        <constraints>
                          <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                      </hspacer>
                    </children>
                  </grid>
                  <component id="c001a" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Equipo identificado:"/>
                    </properties>
                  </component>
                  <component id="c001b" class="javax.swing.JLabel" binding="lblEquipoIdentificado">
                    <constraints>
                      <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="-"/>
                    </properties>
                  </component>
                </children>
              </grid>

              <!-- 4. TARJETA: DETALLE DE EQUIPOS EN EL PRÉSTAMO -->
              <grid id="cardDet" binding="cardDetallePrestamo" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="10">
                <margin top="16" left="20" bottom="16" right="20"/>
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secDet" class="javax.swing.JLabel" binding="lblSeccionDetalle">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="EQUIPOS INCLUIDOS EN EL PRÉSTAMO (DETALLE)"/>
                    </properties>
                  </component>
                  <scrollpane id="c001c" binding="scrollDetalle">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="135"/>
                      </grid>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="c001d" class="javax.swing.JTable" binding="tblDetalle">
                        <constraints/>
                        <properties/>
                      </component>
                    </children>
                  </scrollpane>
                </children>
              </grid>

              <!-- 5. BARRA DE ACCIONES PRINCIPALES -->
              <grid id="c001e" binding="panelAcciones" layout-manager="GridLayoutManager" row-count="1" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="0">
                <margin top="2" left="0" bottom="2" right="0"/>
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="c0020" class="javax.swing.JButton" binding="btnConfirmarPrestamo">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Confirmar préstamo"/>
                    </properties>
                  </component>
                  <component id="c001f" class="javax.swing.JButton" binding="btnNuevo">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Nuevo"/>
                    </properties>
                  </component>
                  <component id="c0021" class="javax.swing.JButton" binding="btnLimpiar">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Limpiar"/>
                    </properties>
                  </component>
                  <hspacer id="c0023">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                  </hspacer>
                  <component id="c0022" class="javax.swing.JButton" binding="btnRegresar">
                    <constraints>
                      <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Volver al Centro de control"/>
                    </properties>
                  </component>
                </children>
              </grid>

              <!-- 6. TARJETA: HISTORIAL Y BÚSQUEDA DE PRÉSTAMOS -->
              <grid id="cardHist" binding="cardHistorialPrestamos" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="12">
                <margin top="18" left="20" bottom="18" right="20"/>
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secHist" class="javax.swing.JLabel" binding="lblSeccionHistorial">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="PRÉSTAMOS REGISTRADOS E HISTORIAL"/>
                    </properties>
                  </component>
                  <grid id="c0024" binding="panelBusqueda" layout-manager="GridLayoutManager" row-count="1" column-count="6" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="0">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="c0025" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Buscar:"/>
                        </properties>
                      </component>
                      <component id="c0026" class="javax.swing.JTextField" binding="txtBuscar">
                        <constraints>
                          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="260" height="34"/>
                          </grid>
                        </constraints>
                        <properties/>
                      </component>
                      <component id="c0027" class="javax.swing.JLabel">
                        <constraints>
                          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Estado:"/>
                        </properties>
                      </component>
                      <component id="c0028" class="javax.swing.JComboBox" binding="cmbFiltroEstado">
                        <constraints>
                          <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="150" height="34"/>
                          </grid>
                        </constraints>
                        <properties>
                          <model>
                            <item value="TODOS"/>
                            <item value="ACTIVO"/>
                            <item value="FINALIZADO"/>
                            <item value="VENCIDO"/>
                          </model>
                        </properties>
                      </component>
                      <component id="c0029" class="javax.swing.JButton" binding="btnBuscar">
                        <constraints>
                          <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <text value="Buscar"/>
                        </properties>
                      </component>
                      <hspacer id="c002a">
                        <constraints>
                          <grid row="0" column="5" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                      </hspacer>
                    </children>
                  </grid>
                  <scrollpane id="c002b" binding="scrollPrestamos">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="190"/>
                      </grid>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
