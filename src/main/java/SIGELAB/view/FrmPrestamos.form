<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SIGELAB.view.FrmPrestamos">
  <grid id="c0000" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="950" height="800"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="c0001" class="javax.swing.JLabel" binding="lblTitulo">
