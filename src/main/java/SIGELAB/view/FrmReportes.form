<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SIGELAB.view.FrmReportes">
  <grid id="c0000" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="5" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="950" height="650"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="c0001" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="18" style="1"/>
          <text value="Reportes"/>
        </properties>
      </component>
      <grid id="c0002" layout-manager="GridLayoutManager" row-count="3" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Parámetros del reporte"/>
        <children>
          <component id="c0003" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Tipo de reporte:"/>
            </properties>
          </component>
          <component id="c0004" class="javax.swing.JComboBox" binding="cmbTipoReporte">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <model>
                <item value="Equipos por estado"/>
                <item value="Préstamos activos"/>
                <item value="Préstamos finalizados"/>
                <item value="Préstamos vencidos"/>
                <item value="Préstamos entre fechas"/>
                <item value="Historial de un equipo"/>
                <item value="Historial de mantenimiento"/>
                <item value="Devoluciones entre fechas"/>
                <item value="Equipos más prestados"/>
              </model>
            </properties>
          </component>
          <component id="c0005" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Laboratorio:"/>
            </properties>
          </component>
          <component id="c0006" class="javax.swing.JComboBox" binding="cmbLaboratorio">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="c0007" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Fecha desde:"/>
            </properties>
          </component>
          <component id="c0008" class="javax.swing.JTextField" binding="txtFechaDesde">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <toolTipText value="Formato: dd/MM/yyyy"/>
            </properties>
          </component>
          <component id="c0009" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Fecha hasta:"/>
            </properties>
          </component>
          <component id="c000a" class="javax.swing.JTextField" binding="txtFechaHasta">
            <constraints>
              <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <toolTipText value="Formato: dd/MM/yyyy"/>
            </properties>
          </component>
          <component id="c000b" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Estado del equipo:"/>
            </properties>
          </component>
          <component id="c000c" class="javax.swing.JComboBox" binding="cmbEstadoEquipo">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <model>
                <item value="TODOS"/>
                <item value="DISPONIBLE"/>
                <item value="PRESTADO"/>
                <item value="DANADO"/>
                <item value="MANTENIMIENTO"/>
                <item value="BAJA"/>
              </model>
            </properties>
          </component>
          <component id="c000d" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Código de equipo:"/>
            </properties>
          </component>
          <component id="c000e" class="javax.swing.JTextField" binding="txtCodigoEquipo">
            <constraints>
              <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <toolTipText value="Para historial de un equipo, por ejemplo CAM-001"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="c000f" layout-manager="GridLayoutManager" row-count="1" column-count="7" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="c0010" class="javax.swing.JButton" binding="btnGenerar">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Generar reporte"/>
            </properties>
          </component>
          <component id="c0011" class="javax.swing.JButton" binding="btnExportarPdf">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Exportar a PDF"/>
            </properties>
          </component>
          <component id="c0012" class="javax.swing.JButton" binding="btnExportarExcel">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Exportar a Excel"/>
            </properties>
          </component>
          <component id="c0013" class="javax.swing.JButton" binding="btnImprimir">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Imprimir"/>
            </properties>
          </component>
          <component id="c0014" class="javax.swing.JButton" binding="btnLimpiar">
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Limpiar"/>
            </properties>
          </component>
          <component id="c0015" class="javax.swing.JButton" binding="btnRegresar">
            <constraints>
              <grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Regresar"/>
            </properties>
          </component>
          <hspacer id="c0016">
            <constraints>
              <grid row="0" column="6" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
        </children>
      </grid>
      <scrollpane id="c0017">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="300"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="c0018" class="javax.swing.JTable" binding="tblResultados">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="c0019" class="javax.swing.JLabel" binding="lblTotalRegistros">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Total de registros: 0"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
