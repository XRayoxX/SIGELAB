<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/"
      version="1"
      bind-to-class="SIGELAB.view.FrmReportes">

  <grid id="principal"
        binding="panelPrincipal"
        layout-manager="GridLayoutManager"
        row-count="1"
        column-count="1"
        same-size-horizontally="false"
        same-size-vertically="false"
        hgap="0"
        vgap="0">

    <margin top="0" left="0" bottom="0" right="0"/>

    <constraints>
      <xy x="20" y="20" width="1150" height="800"/>
    </constraints>

    <properties/>
    <border type="none"/>

    <children>

      <scrollpane id="scrollPrincipal"
                  binding="scrollContenido">

        <constraints>
          <grid row="0" column="0"
                row-span="1" col-span="1"
                vsize-policy="7" hsize-policy="7"
                anchor="0" fill="3"
                indent="0"
                use-parent-layout="false"/>
        </constraints>

        <properties/>
        <border type="none"/>

        <children>

          <grid id="contenido"
                binding="panelContenido"
                layout-manager="GridLayoutManager"
                row-count="5"
                column-count="1"
                same-size-horizontally="false"
                same-size-vertically="false"
                hgap="0"
                vgap="15">

            <margin top="24" left="28"
                    bottom="26" right="28"/>

            <constraints/>
            <properties/>
            <border type="none"/>

            <children>

              <grid id="cabecera"
                    binding="panelEncabezado"
                    layout-manager="GridLayoutManager"
                    row-count="2"
                    column-count="4"
                    same-size-horizontally="false"
                    same-size-vertically="false"
                    hgap="8"
                    vgap="6">

                <margin top="0" left="0"
                        bottom="5" right="0"/>

                <constraints>
                  <grid row="0" column="0"
                        row-span="1" col-span="1"
                        vsize-policy="0" hsize-policy="7"
                        anchor="0" fill="3"
                        indent="0"
                        use-parent-layout="false"/>
                </constraints>

                <properties/>
                <border type="none"/>

                <children>

                  <component id="titulo"
                             class="javax.swing.JLabel"
                             binding="lblTitulo">
                    <constraints>
                      <grid row="0" column="0"
                            row-span="1" col-span="2"
                            vsize-policy="0" hsize-policy="7"
                            anchor="8" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Reportes y consultas"/>
                    </properties>
                  </component>

                  <component id="sol"
                             class="javax.swing.JButton"
                             binding="btnModoClaro">
                    <constraints>
                      <grid row="0" column="2"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="0"
                            anchor="4" fill="0"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="☀"/>
                    </properties>
                  </component>

                  <component id="luna"
                             class="javax.swing.JButton"
                             binding="btnModoOscuro">
                    <constraints>
                      <grid row="0" column="3"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="0"
                            anchor="4" fill="0"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="☾"/>
                    </properties>
                  </component>

                  <component id="subtitulo"
                             class="javax.swing.JLabel"
                             binding="lblSubtitulo">
                    <constraints>
                      <grid row="1" column="0"
                            row-span="1" col-span="4"
                            vsize-policy="0" hsize-policy="7"
                            anchor="8" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="ANÁLISIS OPERATIVO | Equipos, préstamos, devoluciones e historial"/>
                    </properties>
                  </component>

                </children>
              </grid>

              <grid id="filtros"
                    binding="cardFiltros"
                    layout-manager="GridLayoutManager"
                    row-count="4"
                    column-count="4"
                    same-size-horizontally="false"
                    same-size-vertically="false"
                    hgap="12"
                    vgap="12">

                <margin top="20" left="20"
                        bottom="20" right="20"/>

                <constraints>
                  <grid row="1" column="0"
                        row-span="1" col-span="1"
                        vsize-policy="0" hsize-policy="7"
                        anchor="0" fill="3"
                        indent="0"
                        use-parent-layout="false"/>
                </constraints>

                <properties/>
                <border type="none"/>

                <children>

                  <component id="seccionFiltros"
                             class="javax.swing.JLabel"
                             binding="lblSeccionFiltros">
                    <constraints>
                      <grid row="0" column="0"
                            row-span="1" col-span="4"
                            vsize-policy="0" hsize-policy="7"
                            anchor="8" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="PARÁMETROS DEL REPORTE"/>
                    </properties>
                  </component>

                  <component id="labTipo"
                             class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="0"
                            anchor="8" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Tipo de reporte"/>
                    </properties>
                  </component>

                  <component id="tipo"
                             class="javax.swing.JComboBox"
                             binding="cmbTipoReporte">
                    <constraints>
                      <grid row="1" column="1"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="0" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                  </component>

                  <component id="labLaboratorio"
                             class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="2"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="0"
                            anchor="8" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Laboratorio"/>
                    </properties>
                  </component>

                  <component id="laboratorio"
                             class="javax.swing.JComboBox"
                             binding="cmbLaboratorio">
                    <constraints>
                      <grid row="1" column="3"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="0" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                  </component>

                  <component id="labDesde"
                             class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="0"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="0"
                            anchor="8" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Fecha desde"/>
                    </properties>
                  </component>

                  <component id="desde"
                             class="javax.swing.JTextField"
                             binding="txtFechaDesde">
                    <constraints>
                      <grid row="2" column="1"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="0" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <toolTipText value="dd/MM/yyyy"/>
                    </properties>
                  </component>

                  <component id="labHasta"
                             class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="2"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="0"
                            anchor="8" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Fecha hasta"/>
                    </properties>
                  </component>

                  <component id="hasta"
                             class="javax.swing.JTextField"
                             binding="txtFechaHasta">
                    <constraints>
                      <grid row="2" column="3"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="0" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <toolTipText value="dd/MM/yyyy"/>
                    </properties>
                  </component>

                  <component id="labEstado"
                             class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="0"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="0"
                            anchor="8" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Estado del equipo"/>
                    </properties>
                  </component>

                  <component id="estado"
                             class="javax.swing.JComboBox"
                             binding="cmbEstadoEquipo">
                    <constraints>
                      <grid row="3" column="1"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="0" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                  </component>

                  <component id="labCodigo"
                             class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="2"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="0"
                            anchor="8" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Código de equipo"/>
                    </properties>
                  </component>

                  <component id="codigo"
                             class="javax.swing.JTextField"
                             binding="txtCodigoEquipo">
                    <constraints>
                      <grid row="3" column="3"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="0" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <toolTipText value="Ejemplo: CAM-001"/>
                    </properties>
                  </component>

                </children>
              </grid>

              <grid id="acciones"
                    binding="panelAcciones"
                    layout-manager="GridLayoutManager"
                    row-count="2"
                    column-count="3"
                    same-size-horizontally="false"
                    same-size-vertically="false"
                    hgap="10"
                    vgap="10">

                <margin top="2" left="0"
                        bottom="2" right="0"/>

                <constraints>
                  <grid row="2" column="0"
                        row-span="1" col-span="1"
                        vsize-policy="0" hsize-policy="7"
                        anchor="0" fill="3"
                        indent="0"
                        use-parent-layout="false"/>
                </constraints>

                <properties/>
                <border type="none"/>

                <children>

                  <component id="generar"
                             class="javax.swing.JButton"
                             binding="btnGenerar">
                    <constraints>
                      <grid row="0" column="0"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="0" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Generar reporte"/>
                    </properties>
                  </component>

                  <component id="pdf"
                             class="javax.swing.JButton"
                             binding="btnExportarPdf">
                    <constraints>
                      <grid row="0" column="1"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="0" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Exportar PDF"/>
                    </properties>
                  </component>

                  <component id="excel"
                             class="javax.swing.JButton"
                             binding="btnExportarExcel">
                    <constraints>
                      <grid row="0" column="2"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="0" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Exportar Excel (CSV)"/>
                    </properties>
                  </component>

                  <component id="imprimir"
                             class="javax.swing.JButton"
                             binding="btnImprimir">
                    <constraints>
                      <grid row="1" column="0"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="0" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Imprimir"/>
                    </properties>
                  </component>

                  <component id="limpiar"
                             class="javax.swing.JButton"
                             binding="btnLimpiar">
                    <constraints>
                      <grid row="1" column="1"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="0" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Limpiar filtros"/>
                    </properties>
                  </component>

                  <component id="regresar"
                             class="javax.swing.JButton"
                             binding="btnRegresar">
                    <constraints>
                      <grid row="1" column="2"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="0" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Regresar"/>
                    </properties>
                  </component>

                </children>
              </grid>

              <grid id="tabla"
                    binding="cardResultados"
                    layout-manager="GridLayoutManager"
                    row-count="2"
                    column-count="1"
                    same-size-horizontally="false"
                    same-size-vertically="false"
                    hgap="0"
                    vgap="10">

                <margin top="18" left="20"
                        bottom="18" right="20"/>

                <constraints>
                  <grid row="3" column="0"
                        row-span="1" col-span="1"
                        vsize-policy="7" hsize-policy="7"
                        anchor="0" fill="3"
                        indent="0"
                        use-parent-layout="false">
                    <preferred-size width="900" height="370"/>
                  </grid>
                </constraints>

                <properties/>
                <border type="none"/>

                <children>

                  <component id="tituloResultados"
                             class="javax.swing.JLabel"
                             binding="lblSeccionResultados">
                    <constraints>
                      <grid row="0" column="0"
                            row-span="1" col-span="1"
                            vsize-policy="0" hsize-policy="7"
                            anchor="8" fill="1"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="RESULTADOS DE LA CONSULTA"/>
                    </properties>
                  </component>

                  <scrollpane id="scrollTabla"
                              binding="scrollResultados">
                    <constraints>
                      <grid row="1" column="0"
                            row-span="1" col-span="1"
                            vsize-policy="7" hsize-policy="7"
                            anchor="0" fill="3"
                            indent="0"
                            use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="tablaResultados"
                                 class="javax.swing.JTable"
                                 binding="tblResultados">
                        <constraints/>
                        <properties/>
                      </component>
                    </children>
                  </scrollpane>

                </children>
              </grid>

              <component id="total"
                         class="javax.swing.JLabel"
                         binding="lblTotalRegistros">
                <constraints>
                  <grid row="4" column="0"
                        row-span="1" col-span="1"
                        vsize-policy="0" hsize-policy="7"
                        anchor="8" fill="1"
                        indent="0"
                        use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Total de registros: 0"/>
                </properties>
              </component>

            </children>
          </grid>

        </children>
      </scrollpane>

    </children>
  </grid>
</form>
