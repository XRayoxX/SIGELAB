<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SIGELAB.view.FrmDevoluciones">
  <grid id="c0000" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="1100" height="1100"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="scroll" binding="scrollContenido">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="contenido" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="14">
            <margin top="24" left="28" bottom="24" right="28"/>
            <constraints/>
            <properties>
              <background color="-3289651"/>
            </properties>
            <border type="none"/>
            <children>
              <!-- 1. ENCABEZADO DEL MÓDULO -->
              <grid id="cabecera" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="4">
                <margin top="0" left="0" bottom="4" right="0"/>
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="c0001" class="javax.swing.JLabel" binding="lblTitulo">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Devolución de Equipo"/>
                    </properties>
                  </component>
                  <component id="btnSol" class="javax.swing.JButton" binding="btnModoClaro">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="43" height="35"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="☀"/>
                      <toolTipText value="Modo claro"/>
                    </properties>
                  </component>
                  <component id="btnLuna" class="javax.swing.JButton" binding="btnModoOscuro">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="43" height="35"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="☾"/>
                      <toolTipText value="Modo oscuro"/>
                    </properties>
                  </component>
                  <component id="subtitulo" class="javax.swing.JLabel" binding="lblSubtitulo">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="OPERACIONES DE LABORATORIO  |  Recepción de equipos prestados, devolución parcial o completa y condición de cada equipo"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 2. TARJETA: BUSCAR PRÉSTAMO ACTIVO -->
              <grid id="c0002" binding="cardPrestamos" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
                <margin top="16" left="20" bottom="20" right="20"/>
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secPre" class="javax.swing.JLabel" binding="lblSeccionPrestamos">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="PRÉSTAMOS ACTIVOS"/>
                    </properties>
                  </component>
                  <component id="c0003" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Buscar préstamo activo:"/>
                    </properties>
                  </component>
                  <component id="c0004" class="javax.swing.JTextField" binding="txtBuscar">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="260" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <toolTipText value="No. de préstamo, carné o nombre del solicitante"/>
                    </properties>
                  </component>
                  <component id="c0005" class="javax.swing.JButton" binding="btnBuscar">
                    <constraints>
                      <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="110" height="36"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Buscar"/>
                    </properties>
                  </component>
                  <scrollpane id="c0006">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="180"/>
                      </grid>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="c0007" class="javax.swing.JTable" binding="tblPrestamosActivos">
                        <constraints/>
                        <properties/>
                      </component>
                    </children>
                  </scrollpane>
                </children>
              </grid>
              <!-- 3. TARJETA: DATOS DEL PRÉSTAMO -->
              <grid id="c0008" binding="cardDatosPrestamo" layout-manager="GridLayoutManager" row-count="4" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="14" vgap="10">
                <margin top="18" left="20" bottom="18" right="20"/>
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secDat" class="javax.swing.JLabel" binding="lblSeccionDatos">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="DATOS DEL PRÉSTAMO"/>
                    </properties>
                  </component>
                  <component id="c0009" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="No. de préstamo:"/>
                    </properties>
                  </component>
                  <component id="c000a" class="javax.swing.JTextField" binding="txtNoPrestamo">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c000b" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Solicitante:"/>
                    </properties>
                  </component>
                  <component id="c000c" class="javax.swing.JTextField" binding="txtSolicitante">
                    <constraints>
                      <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c000d" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Fecha de préstamo:"/>
                    </properties>
                  </component>
                  <component id="c000e" class="javax.swing.JTextField" binding="txtFechaPrestamo">
                    <constraints>
                      <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c000f" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Fecha esperada de devolución:"/>
                    </properties>
                  </component>
                  <component id="c0010" class="javax.swing.JTextField" binding="txtFechaEsperadaDevolucion">
                    <constraints>
                      <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c0011" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Días de atraso:"/>
                    </properties>
                  </component>
                  <component id="c0012" class="javax.swing.JTextField" binding="txtDiasAtraso">
                    <constraints>
                      <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c0013" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Equipos pendientes:"/>
                    </properties>
                  </component>
                  <component id="c0014" class="javax.swing.JTextField" binding="txtEquiposPendientes">
                    <constraints>
                      <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 4. TARJETA: EQUIPOS DEL PRÉSTAMO -->
              <grid id="c0015" binding="cardEquipos" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="10">
                <margin top="16" left="20" bottom="20" right="20"/>
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secEqu" class="javax.swing.JLabel" binding="lblSeccionEquipos">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="EQUIPOS DEL PRÉSTAMO (SELECCIONE UNO PENDIENTE)"/>
                    </properties>
                  </component>
                  <scrollpane id="c0016">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="170"/>
                      </grid>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="c0017" class="javax.swing.JTable" binding="tblEquiposPrestamo">
                        <constraints/>
                        <properties/>
                      </component>
                    </children>
                  </scrollpane>
                </children>
              </grid>
              <!-- 5. TARJETA: DEVOLUCIÓN DEL EQUIPO SELECCIONADO -->
              <grid id="c0018" binding="cardDevolucion" layout-manager="GridLayoutManager" row-count="4" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="14" vgap="10">
                <margin top="18" left="20" bottom="18" right="20"/>
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secDev" class="javax.swing.JLabel" binding="lblSeccionDevolucion">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="DEVOLUCIÓN DEL EQUIPO SELECCIONADO"/>
                    </properties>
                  </component>
                  <component id="c0019" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Equipo:"/>
                    </properties>
                  </component>
                  <component id="c001a" class="javax.swing.JTextField" binding="txtEquipo">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c001b" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Condición:"/>
                    </properties>
                  </component>
                  <component id="c001c" class="javax.swing.JComboBox" binding="cmbCondicion">
                    <constraints>
                      <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <model>
                        <item value="BUENO"/>
                        <item value="DANADO"/>
                      </model>
                      <toolTipText value="BUENO deja el equipo DISPONIBLE; DANADO lo marca DANADO"/>
                    </properties>
                  </component>
                  <component id="c001d" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Fecha de devolución:"/>
                    </properties>
                  </component>
                  <component id="c001e" class="javax.swing.JTextField" binding="txtFechaDevolucion">
                    <constraints>
                      <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c001f" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Observaciones:"/>
                    </properties>
                  </component>
                  <scrollpane id="c0020">
                    <constraints>
                      <grid row="3" column="1" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="70"/>
                      </grid>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="c0021" class="javax.swing.JTextArea" binding="txaObservaciones">
                        <constraints/>
                        <properties>
                          <lineWrap value="true"/>
                          <rows value="3"/>
                          <wrapStyleWord value="true"/>
                        </properties>
                      </component>
                    </children>
                  </scrollpane>
                </children>
              </grid>
              <!-- 6. ACCIONES -->
              <grid id="c0022" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="0">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="c0023" class="javax.swing.JButton" binding="btnRegistrarDevolucion">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Registrar devolución"/>
                    </properties>
                  </component>
                  <component id="c0024" class="javax.swing.JButton" binding="btnLimpiar">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Limpiar"/>
                    </properties>
                  </component>
                  <hspacer id="c0025">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                  </hspacer>
                  <component id="c0026" class="javax.swing.JButton" binding="btnRegresar">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Regresar"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 7. INDICACIONES -->
              <component id="indic" class="javax.swing.JLabel" binding="lblIndicaciones">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="El préstamo sigue ACTIVO mientras quede al menos un equipo pendiente. Si el equipo regresa DANADO, describa el daño en Observaciones."/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
