<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SIGELAB.view.Login">
  <grid id="c0000" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="12">
    <margin top="24" left="36" bottom="24" right="36"/>
    <constraints>
      <xy x="20" y="20" width="760" height="620"/>
    </constraints>
    <properties>
      <background color="-592138"/>
      <minimumSize width="650" height="570"/>
      <preferredSize width="760" height="620"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="c0001" class="javax.swing.JLabel" binding="lblEncabezado">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Arial" size="12" style="1"/>
          <foreground color="-15782586"/>
          <text value="SIGELAB     "/>
        </properties>
      </component>
      <component id="c0002" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Arial" size="32" style="1"/>
          <foreground color="-15782586"/>
          <text value="SIGELAB"/>
        </properties>
      </component>
      <component id="c0003" class="javax.swing.JLabel" binding="lblSubtitulo">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Arial" size="12"/>
          <foreground color="-10262403"/>
          <text value="Sistema de Gestión y Control de Laboratorios Universitarios"/>
        </properties>
      </component>
      <grid id="c0004" binding="panelCredenciales" layout-manager="GridLayoutManager" row-count="6" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="12">
        <margin top="20" left="25" bottom="20" right="25"/>
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="500" height="230"/>
          </grid>
        </constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="etched" title="">
          <font name="Arial" size="14" style="1"/>
          <title-color color="-15782586"/>
        </border>
        <children>
          <component id="c0005" class="javax.swing.JLabel" binding="lblUsuario">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="12" style="1"/>
              <foreground color="-15782586"/>
              <text value="Usuario"/>
            </properties>
          </component>
          <component id="c0006" class="javax.swing.JTextField" binding="txtUsuario">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="400" height="38"/>
              </grid>
            </constraints>
            <properties>
              <font name="Arial" size="14"/>
              <toolTipText value="Ingrese su nombre de usuario"/>
            </properties>
          </component>
          <component id="c0007" class="javax.swing.JLabel" binding="lblContrasena">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="12" style="1"/>
              <foreground color="-15782586"/>
              <text value="Contraseña"/>
            </properties>
          </component>
          <component id="c0008" class="javax.swing.JPasswordField" binding="pwdContrasena">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="320" height="38"/>
              </grid>
            </constraints>
            <properties>
              <font name="Arial" size="14"/>
            </properties>
          </component>
          <component id="c0009" class="javax.swing.JCheckBox" binding="chkMostrarContrasena">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-1"/>
              <font name="Arial" size="11"/>
              <text value="Mostrar"/>
            </properties>
          </component>
          <vspacer id="c000a">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
          <component id="c000b" class="javax.swing.JLabel" binding="lblAyuda">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="11"/>
              <foreground color="-10262403"/>
              <text value=""/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="c000c" binding="panelFacial" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="8">
        <margin top="15" left="20" bottom="15" right="20"/>
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-1050378"/>
        </properties>
        <border type="etched" title="Segundo factor de autenticación">
          <font name="Arial" size="12" style="1"/>
          <title-color color="-15782586"/>
        </border>
        <children>
          <component id="c000d" class="javax.swing.JLabel" binding="lblFacialTitulo">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="12" style="1"/>
              <foreground color="-15782586"/>
              <text value="Reconocimiento facial de guardia"/>
            </properties>
          </component>
          <component id="c000e" class="javax.swing.JLabel" binding="lblEstadoFacial">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="11"/>
              <foreground color="-10262403"/>
              <text value="Estado: integración facial pendiente"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="c000f" binding="panelBotones" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="0">
        <margin top="5" left="10" bottom="5" right="10"/>
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-592138"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="c0010" class="javax.swing.JButton" binding="btnIngresar">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="300" height="44"/>
              </grid>
            </constraints>
            <properties>
              <background color="-15782586"/>
              <font name="Arial" size="13" style="1"/>
              <foreground color="-1"/>
              <text value="Ingresar al sistema"/>
            </properties>
          </component>
          <component id="c0011" class="javax.swing.JButton" binding="btnSalir">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="100" height="44"/>
              </grid>
            </constraints>
            <properties>
              <font name="Arial" size="12"/>
              <text value="Salir"/>
            </properties>
          </component>
        </children>
      </grid>
      <component id="c0012" class="javax.swing.JLabel" binding="lblPiePagina">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Arial" size="11"/>
          <foreground color="-10262403"/>
          <horizontalAlignment value="0"/>
          <text value=""/>
        </properties>
      </component>
    </children>
  </grid>
</form>
