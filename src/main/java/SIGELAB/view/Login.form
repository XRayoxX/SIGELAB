<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SIGELAB.view.Login">
  <grid id="rootPanel" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="24" left="24" bottom="24" right="24"/>
    <constraints>
      <xy x="20" y="20" width="520" height="420"/>
    </constraints>
    <properties>
      <background color="-1"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="cardPanel" layout-manager="GridLayoutManager" row-count="9" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="12">
        <margin top="28" left="36" bottom="28" right="36"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="460" height="350"/>
          </grid>
        </constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="line">
          <color color="-1644826"/>
        </border>
        <children>
          <component id="lblTitulo" class="javax.swing.JLabel" binding="lblTitulo">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="26" style="1"/>
              <foreground color="-16744448"/>
              <text value="SIGELAB"/>
            </properties>
          </component>
          <component id="lblSubtitulo" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="11" style="0"/>
              <foreground color="-10066330"/>
              <text value="Sistema de Gestión y Control de Laboratorios Universitarios"/>
            </properties>
          </component>
          <component id="sepHeader" class="javax.swing.JSeparator">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="10"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <grid id="credencialesPanel" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="12">
            <margin top="16" left="20" bottom="16" right="20"/>
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-1"/>
            </properties>
            <border type="line">
              <color color="-1644826"/>
            </border>
            <children>
              <component id="lblUsuario" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="11" style="1"/>
                  <foreground color="-13421773"/>
                  <text value="Usuario"/>
                </properties>
              </component>
              <component id="txtUsuario" class="javax.swing.JTextField" binding="txtUsuario">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="240" height="34"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="lblContrasena" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="11" style="1"/>
                  <foreground color="-13421773"/>
                  <text value="Contraseña"/>
                </properties>
              </component>
              <component id="pwdContrasena" class="javax.swing.JPasswordField" binding="pwdContrasena">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="240" height="34"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
            </children>
          </grid>
          <grid id="facialPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="-1">
            <margin top="14" left="20" bottom="14" right="20"/>
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-1"/>
            </properties>
            <border type="line">
              <color color="-1644826"/>
            </border>
            <children>
              <component id="lblEstadoFacialTitulo" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="11" style="1"/>
                  <foreground color="-13421773"/>
                  <text value="Estado Facial"/>
                </properties>
              </component>
              <component id="lblEstadoFacial" class="javax.swing.JLabel" binding="lblEstadoFacial">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <foreground color="-10066330"/>
                  <text value="Pendiente: se solicitará al validar usuario y contraseña"/>
                </properties>
              </component>
            </children>
          </grid>
          <component id="btnFacial" class="javax.swing.JButton" binding="btnFacial">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="38"/>
              </grid>
            </constraints>
            <properties>
              <background color="-16744448"/>
              <focusable value="true"/>
              <font size="11" style="1"/>
              <foreground color="-1"/>
              <text value="RECONOCIMIENTO FACIAL"/>
            </properties>
          </component>
          <grid id="botonesPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="-1">
            <margin top="2" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-1"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="btnIngresar" class="javax.swing.JButton" binding="btnIngresar">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="38"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-16744448"/>
                  <focusable value="true"/>
                  <font size="11" style="1"/>
                  <foreground color="-1"/>
                  <text value="INGRESAR"/>
                </properties>
              </component>
              <component id="btnSalir" class="javax.swing.JButton" binding="btnSalir">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="38"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-16744448"/>
                  <font size="11" style="1"/>
                  <foreground color="-1"/>
                  <text value="SALIR"/>
                </properties>
              </component>
            </children>
          </grid>
          <vspacer id="vspacerBottom">
            <constraints>
              <grid row="8" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
          <component id="lblFooter" class="javax.swing.JLabel">
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="9" style="0"/>
              <foreground color="-8355712"/>
              <text value="Acceso seguro con credenciales y reconocimiento facial"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
