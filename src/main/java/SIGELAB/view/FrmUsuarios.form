                      <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Limpiar"/>
                    </properties>
                  </component>
                  <hspacer id="c0036">
                    <constraints>
                      <grid row="0" column="5" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                  </hspacer>
                  <component id="c0037" class="javax.swing.JButton" binding="btnRegresar">
                    <constraints>
                      <grid row="0" column="6" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Regresar"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 6. TARJETA: REGISTROS -->
              <grid id="regs" binding="cardRegistros" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="10">
                <margin top="16" left="20" bottom="20" right="20"/>
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secReg" class="javax.swing.JLabel" binding="lblSeccionRegistros">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="USUARIOS REGISTRADOS"/>
                    </properties>
                  </component>
                  <scrollpane id="c0044">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="240"/>
                      </grid>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="c0045" class="javax.swing.JTable" binding="tblUsuarios">
                        <constraints/>
                        <properties/>
                      </component>
                    </children>
                  </scrollpane>
                </children>
              </grid>
              <!-- 7. INDICACIONES -->
              <component id="indic" class="javax.swing.JLabel" binding="lblIndicaciones">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="El nombre de usuario se genera al guardar. Al actualizar, deje la contraseña vacía para conservar la actual. Un usuario INACTIVO no puede iniciar sesión."/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
