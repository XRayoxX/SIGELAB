<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SIGELAB.view.FrmUsuarios">
  <grid id="c0000" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="1100" height="980"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="scroll" binding="scrollContenido">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="contenido" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="14">
            <margin top="24" left="28" bottom="24" right="28"/>
            <constraints/>
            <properties>
              <background color="-3289651"/>
            </properties>
            <border type="none"/>
            <children>
              <!-- 1. ENCABEZADO DEL MÓDULO -->
              <grid id="cabecera" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="4">
                <margin top="0" left="0" bottom="4" right="0"/>
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="c0001" class="javax.swing.JLabel" binding="lblTitulo">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Gestión de Usuarios"/>
                    </properties>
                  </component>
                  <component id="btnSol" class="javax.swing.JButton" binding="btnModoClaro">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="43" height="35"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="☀"/>
                      <toolTipText value="Modo claro"/>
                    </properties>
                  </component>
                  <component id="btnLuna" class="javax.swing.JButton" binding="btnModoOscuro">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="43" height="35"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="☾"/>
                      <toolTipText value="Modo oscuro"/>
                    </properties>
                  </component>
                  <component id="subtitulo" class="javax.swing.JLabel" binding="lblSubtitulo">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="ADMINISTRACIÓN  |  Cuentas del sistema, roles, estado y registro facial para el inicio de sesión"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 2. TARJETA: BÚSQUEDA -->
              <grid id="c0040" binding="cardBusqueda" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
                <margin top="16" left="20" bottom="16" right="20"/>
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secBus" class="javax.swing.JLabel" binding="lblSeccionBusqueda">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="BÚSQUEDA"/>
                    </properties>
                  </component>
                  <component id="c0041" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Buscar:"/>
                    </properties>
                  </component>
                  <component id="c0042" class="javax.swing.JTextField" binding="txtBuscar">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="260" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <toolTipText value="Nombre de usuario, nombres o apellidos"/>
                    </properties>
                  </component>
                  <component id="c0043" class="javax.swing.JButton" binding="btnBuscar">
                    <constraints>
                      <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="110" height="36"/>
                      </grid>
                    </constraints>
                    <properties>
                      <text value="Buscar"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 3. TARJETA: DATOS PERSONALES -->
              <grid id="c0002" binding="cardDatos" layout-manager="GridLayoutManager" row-count="5" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="14" vgap="10">
                <margin top="18" left="20" bottom="18" right="20"/>
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secDat" class="javax.swing.JLabel" binding="lblSeccionDatos">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="DATOS PERSONALES"/>
                    </properties>
                  </component>
                  <component id="c0003" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="ID:"/>
                    </properties>
                  </component>
                  <component id="c0004" class="javax.swing.JTextField" binding="txtId">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c0005" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Nombre de usuario:"/>
                    </properties>
                  </component>
                  <component id="c0006" class="javax.swing.JTextField" binding="txtUsuario">
                    <constraints>
                      <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <editable value="false"/>
                    </properties>
                  </component>
                  <component id="c0007" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Primer nombre:"/>
                    </properties>
                  </component>
                  <component id="c0008" class="javax.swing.JTextField" binding="txtNombre">
                    <constraints>
                      <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="c0009" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Segundo nombre:"/>
                    </properties>
                  </component>
                  <component id="c000a" class="javax.swing.JTextField" binding="Txt_Segundo_nombre">
                    <constraints>
                      <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="c000b" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Primer apellido:"/>
                    </properties>
                  </component>
                  <component id="c000c" class="javax.swing.JTextField" binding="txtApellido">
                    <constraints>
                      <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="c000d" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Segundo apellido:"/>
                    </properties>
                  </component>
                  <component id="c000e" class="javax.swing.JTextField" binding="TXT_segundoApellido">
                    <constraints>
                      <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="c000f" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Correo electrónico:"/>
                    </properties>
                  </component>
                  <component id="c0010" class="javax.swing.JTextField" binding="txtCorreo">
                    <constraints>
                      <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="c0011" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="4" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Rol:"/>
                    </properties>
                  </component>
                  <component id="c0012" class="javax.swing.JComboBox" binding="cmbRol">
                    <constraints>
                      <grid row="4" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <model>
                        <item value="ADMIN"/>
                        <item value="ENCARGADO"/>
                        <item value="DOCENTE"/>
                      </model>
                    </properties>
                  </component>
                </children>
              </grid>
              <!-- 4. TARJETA: ACCESO Y SEGURIDAD -->
              <grid id="c0020" binding="cardAcceso" layout-manager="GridLayoutManager" row-count="3" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="14" vgap="10">
                <margin top="18" left="20" bottom="18" right="20"/>
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="secAcc" class="javax.swing.JLabel" binding="lblSeccionAcceso">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="7" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="ACCESO Y SEGURIDAD"/>
                    </properties>
                  </component>
                  <component id="c0021" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Contraseña:"/>
                    </properties>
                  </component>
                  <component id="c0022" class="javax.swing.JPasswordField" binding="pwdContrasena">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="c0023" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Confirmar contraseña:"/>
                    </properties>
                  </component>
                  <component id="c0024" class="javax.swing.JPasswordField" binding="pwdConfirmarContrasena">
                    <constraints>
                      <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="c0025" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Estado:"/>
                    </properties>
                  </component>
                  <component id="c0026" class="javax.swing.JComboBox" binding="cmbEstado">
                    <constraints>
                      <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="180" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
                      <model>
                        <item value="ACTIVO"/>
                        <item value="INACTIVO"/>
                      </model>
                    </properties>
                  </component>
                  <component id="c0027" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Rostro (facial):"/>
                    </properties>
                  </component>
                  <grid id="c0028" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="0">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints>
                      <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <component id="c0029" class="javax.swing.JTextField" binding="txtRutaFotoRostro">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                            <preferred-size width="120" height="34"/>
                          </grid>
                        </constraints>
                        <properties>
                          <editable value="false"/>
                          <toolTipText value="Estado del registro facial del usuario seleccionado"/>
                        </properties>
                      </component>
                      <component id="c002a" class="javax.swing.JButton" binding="btnSeleccionarFoto">
                        <constraints>
                          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                            <preferred-size width="-1" height="34"/>
                          </grid>
                        </constraints>
                        <properties>
                          <text value="Registrar rostro..."/>
                          <toolTipText value="Abre la cámara para registrar, reemplazar o eliminar el rostro del usuario seleccionado"/>
                        </properties>
                      </component>
                    </children>
                  </grid>
                </children>
              </grid>
              <!-- 5. ACCIONES -->
              <grid id="c0030" layout-manager="GridLayoutManager" row-count="1" column-count="7" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="0">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="c0031" class="javax.swing.JButton" binding="btnNuevo">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="38"/>
                      </grid>
                    </constraints>
